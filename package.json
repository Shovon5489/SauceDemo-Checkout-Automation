{
  "type": "module",
  "dependencies": {
    "axios": "^1.20.0",
    "selenium-webdriver": "^4.51.0"
  },
  "devDependencies": {
    "allure-commandline": "^2.46.1",
    "allure-mocha": "^3.13.0",
    "mocha": "^12.0.3"
  },
  "scripts": {
    "test": "node run-tests.js",
    "test:locked-out": "npm test -- --grep \"Scenario 1: locked-out user login\"",
    "test:standard": "npm test -- --grep \"Scenario 2: standard_user checkout\"",
    "test:performance": "npm test -- --grep \"Scenario 3: performance_glitch_user checkout\"",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  }
}
